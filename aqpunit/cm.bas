700 GOTO _finish

710 _init_screen:
712 SET COLOR OFF
714 IF SC=40 THEN SCREEN 2,,,,1:GOSUB _set_screen:SCREEN 3:RETURN
716 STASH SCREEN:SCREEN 3,,,,1:GOSUB _set_screen:SWAP SCREEN:RETURN
718 _set_screen:SET CURSOR OFF:SET COLOR OFF:CLS:RETURN

720 _wscrn:
724 IF SC=40 THEN SCREEN 2:RETURN
726 SWAP SCREEN:RETURN

730 _mscrn:
732 IF SC=40 THEN SCREEN 3:RETURN
734 SWAP SCREEN:RETURN

750 _peekcolor:
751 'Must be in work screen on entry, exits in main screen
752 FOR I=0 TO 6:S=I*SC
753 L$(I)="I=%%:S=%%:"%(I,S)+LIST$(NEXT)
754 P$(I)=PEEKCOLOR$(S,7)
755 NEXT:GOSUB _getkey:GOSUB _mscrn:GOSUB _outnewline
756 FOR I=0 TO 6:GOSUB _output:ARGS L$(I):NEXT
758 GOSUB _outnewline:RETURN

760 _peekcolormap:
761 'Must be in work screen on entry, exits in main screen
762 FOR I=0 TO 5:S=8192+I*40
763 L$(I)="I=%%:S=%%:"%(I,S)+LIST$(NEXT)
764 P$(I)=PEEK$(@20,S,7)
765 NEXT:GOSUB _getkey:SCREEN 3,0:GOSUB _outnewline
766 FOR I=0 TO 6:GOSUB _output:ARGS L$(I):NEXT
768 GOSUB _outnewline:RETURN
